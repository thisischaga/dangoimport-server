# ─── Serveur ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
JSON_BODY_LIMIT=5mb

# ─── Base de données ───────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/dangoimport

# ─── Auth JWT (générer une clé aléatoire ≥ 32 caractères) ─────────────────
JWT_SECRET=replace_with_long_random_secret_min_32_chars
JWT_EXPIRES_IN=12h
JWT_ADMIN_EXPIRES_IN=30m

# ─── CORS (origines supplémentaires, séparées par des virgules) ────────────
CORS_ALLOWED_ORIGINS=

# ─── E-mail / alertes sécurité ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL=contact@example.com
EMAIL_PASS=replace_with_app_password
SECURITY_ALERT_EMAIL=security@example.com
SECURITY_ALERT_ENABLED=true
SECURITY_ALERT_FROM=Dango import Sécurité <security@example.com>

# ─── Paiement FedaPay ──────────────────────────────────────────────────────
FEDAPAY_SECRET_KEY=sk_live_or_sk_test_xxxxxxxx
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxx
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_RETURN_URL=https://dangoimport.com/checkout

# ─── Cloudinary (upload images) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=replace_with_cloudinary_secret

# ─── OAuth Google ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# ─── App mobile livreur ────────────────────────────────────────────────────
DRIVER_APP_MIN_VERSION=1.0.0
DRIVER_APP_LATEST_VERSION=1.0.0
DRIVER_APP_STORE_URL=https://play.google.com/store/apps/details?id=com.dpay.app

# ─── Socket.io ─────────────────────────────────────────────────────────────
SOCKET_STRICT_AUTH=true
